# Variabel environment untuk proyek SawitKu
# Salin file ini menjadi .env (untuk web) atau masukkan ke BuildConfig (untuk Android)
# JANGAN commit file .env ke repository!

# ============================================================
# SUPABASE — ambil dari: Supabase Dashboard > Project Settings > API
# ============================================================

# URL proyek Supabase Anda (format: https://xxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon/Public key — AMAN untuk dipakai di klien (Android & web)
# Ini BUKAN service_role key. RLS melindungi data meski key ini diketahui publik.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# CATATAN KEAMANAN
# ============================================================
# - JANGAN pernah menaruh service_role key di Android atau web frontend.
# - service_role key hanya untuk server-side / Edge Functions Supabase.
# - Anon key + RLS sudah cukup aman untuk aplikasi ini.
# - Jika ada suatu hari fitur admin panel server-side, gunakan Edge Function
#   Supabase dengan service_role key di environment Supabase, bukan di kode klien.

# ============================================================
# WEB APP (Next.js / Vite — FASE 4)
# ============================================================
# Ganti prefix NEXT_PUBLIC_ atau VITE_ sesuai framework yang dipakai
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
